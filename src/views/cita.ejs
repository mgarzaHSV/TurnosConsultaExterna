<%- include( 'partials/head', {titulo: 'Recepción - Agregar Consulta'}) %>
<%- include('partials/header') %>
<body>
    <h1>Bienvenido a la página de citas</h1>
    <!-- Agregar boton para poder agregar una nueva cita -->
     <div class="flex justify-center">
        <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            Agregar Nueva Cita
        </button>
     </div>
     <section class="mt-8 flex flex-wrap gap-6">
         <%- include('components/componenteCita')  %>
         <%- include('components/componenteCita')  %>
         <%- include('components/componenteCita')  %>
         <%- include('components/componenteCita')  %>
         <%- include('components/componenteCita')  %>
         <%- include('components/componenteCita')  %>
    </section>

        <section id="view-register" class="view-section hidden-view min-h-screen bg-slate-50 p-6 md:p-12">
        <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="bg-white border-b border-slate-100 p-6 flex items-center gap-3">
                <i data-lucide="file-text" class="text-blue-600"></i>
                <h2 class="text-xl font-semibold text-slate-800">Registro de Paciente & Triage</h2>
            </div>
            
            <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Datos Personales -->
                <div class="space-y-4">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 border-b pb-2">Datos Generales</h3>
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Nombre Completo</label>
                        <input id="input-name" type="text" value="Ricardo M. Lopez" class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                    </div>
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Número de Turno (Auto)</label>
                        <input id="input-turn" type="text" value="T-102" class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors font-mono font-bold">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm text-slate-600 mb-1">Edad</label>
                            <input id="input-age" type="number" value="34" class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                        </div>
                        <div>
                            <label class="block text-sm text-slate-600 mb-1">Sexo</label>
                            <select id="input-sex" class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                                <option>Masculino</option>
                                <option>Femenino</option>
                                <option>Otro</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- NEW: Consulting Room Input for logic testing -->
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Consultorio Asignado (Escribe 1, 2 o 3)</label>
                        <input id="input-room" type="text" value="Consultorio 2" class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors" placeholder="Ej: Consultorio 1">
                        <p class="text-xs text-slate-400 mt-1">Prueba escribiendo "1", "2" o "3" para cambiar la flecha en la pantalla de turno.</p>
                    </div>
                </div>

                <!-- Signos Vitales -->
                <div class="space-y-4">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 border-b pb-2">Signos Vitales</h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                            <label class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
                                <i data-lucide="activity" class="w-3 h-3"></i> P/A
                            </label>
                            <input id="input-bp" value="120/80" class="w-full bg-transparent font-mono text-lg text-slate-800 outline-none">
                        </div>
                        <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                            <label class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
                                <i data-lucide="heart" class="w-3 h-3"></i> FC
                            </label>
                            <input id="input-hr" value="85" class="w-full bg-transparent font-mono text-lg text-slate-800 outline-none">
                        </div>
                        <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                            <label class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
                                <i data-lucide="thermometer" class="w-3 h-3"></i> Temp
                            </label>
                            <input id="input-temp" value="37.5" class="w-full bg-transparent font-mono text-lg text-slate-800 outline-none">
                        </div>
                        <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
                            <label class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
                                <i data-lucide="wind" class="w-3 h-3"></i> SpO2
                            </label>
                            <input id="input-o2" value="98" class="w-full bg-transparent font-mono text-lg text-slate-800 outline-none">
                        </div>
                    </div>
                </div>

                <!-- Manchester Triage Selector -->
                <div class="md:col-span-2 mt-4">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-6 border-b pb-2">Clasificación Manchester</h3>
                    <div class="grid grid-cols-2 md:grid-cols-5 gap-3" id="triage-selector">
                        <!-- Red -->
                        <button onclick="selectTriage('red', 'Inmediato')" class="triage-btn relative p-4 rounded-xl border-2 border-transparent bg-slate-50 hover:bg-slate-100 flex flex-col items-center gap-2 text-center transition-all opacity-70 hover:opacity-100" data-color="red">
                            <div class="w-8 h-8 rounded-full shadow-sm bg-red-500"></div>
                            <span class="text-xs font-bold text-slate-700">Inmediato</span>
                        </button>
                        <!-- Orange -->
                        <button onclick="selectTriage('orange', 'Muy Urgente')" class="triage-btn relative p-4 rounded-xl border-2 border-transparent bg-slate-50 hover:bg-slate-100 flex flex-col items-center gap-2 text-center transition-all opacity-70 hover:opacity-100" data-color="orange">
                            <div class="w-8 h-8 rounded-full shadow-sm bg-orange-500"></div>
                            <span class="text-xs font-bold text-slate-700">Muy Urgente</span>
                        </button>
                        <!-- Yellow (Default Selected in Mock) -->
                        <button onclick="selectTriage('yellow', 'Urgente')" class="triage-btn active relative p-4 rounded-xl border-2 border-slate-800 bg-white transform scale-105 shadow-md flex flex-col items-center gap-2 text-center transition-all" data-color="yellow">
                            <div class="w-8 h-8 rounded-full shadow-sm bg-yellow-500"></div>
                            <span class="text-xs font-bold text-slate-700">Urgente</span>
                            <div class="absolute top-2 right-2 text-slate-800"><i data-lucide="check-circle" class="w-4 h-4"></i></div>
                        </button>
                        <!-- Green -->
                        <button onclick="selectTriage('green', 'Estándar')" class="triage-btn relative p-4 rounded-xl border-2 border-transparent bg-slate-50 hover:bg-slate-100 flex flex-col items-center gap-2 text-center transition-all opacity-70 hover:opacity-100" data-color="green">
                            <div class="w-8 h-8 rounded-full shadow-sm bg-green-500"></div>
                            <span class="text-xs font-bold text-slate-700">Estándar</span>
                        </button>
                        <!-- Blue -->
                        <button onclick="selectTriage('blue', 'No Urgente')" class="triage-btn relative p-4 rounded-xl border-2 border-transparent bg-slate-50 hover:bg-slate-100 flex flex-col items-center gap-2 text-center transition-all opacity-70 hover:opacity-100" data-color="blue">
                            <div class="w-8 h-8 rounded-full shadow-sm bg-blue-500"></div>
                            <span class="text-xs font-bold text-slate-700">No Urgente</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="p-6 bg-slate-50 border-t border-slate-100 flex justify-end">
                <button onclick="saveAndGoToQueue()" class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition-colors shadow-lg shadow-blue-200">
                    Registrar y generar turno
                </button>
            </div>
        </div>
    </section>


    <!-- 3. STATUS MANAGER VIEW -->
    <section id="view-status" class="view-section hidden-view min-h-screen bg-slate-100 p-8 flex items-center justify-center">
        <div class="w-full max-w-lg bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
            <!-- Dynamic Header Color -->
            <div id="status-header-color" class="h-3 bg-yellow-500"></div>
            
            <div class="p-8">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800 display-name">Ricardo M. Lopez</h2>
                        <p class="text-slate-500">ID: #492-A • <span class="display-age">34</span> años</p>
                    </div>
                    <span id="status-triage-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-slate-100 text-slate-600">
                        Urgente
                    </span>
                </div>

                <div class="mb-8">
                    <h3 class="text-xs font-bold text-slate-400 uppercase mb-3">Cambiar Estatus</h3>
                    <div class="space-y-2">
                        <!-- Status Buttons -->
                        <button onclick="setStatus(this, 'Pendiente')" class="status-btn w-full flex items-center justify-between p-4 rounded-xl border border-blue-500 bg-blue-50 text-blue-700 shadow-inner transition-all">
                            <span class="font-medium">Pendiente</span>
                            <i data-lucide="check-circle" class="w-5 h-5"></i>
                        </button>
                        <button onclick="setStatus(this, 'Proyectada')" class="status-btn w-full flex items-center justify-between p-4 rounded-xl border border-slate-100 bg-white hover:bg-slate-50 text-slate-600 transition-all">
                            <span class="font-medium">Proyectada</span>
                        </button>
                        <button onclick="setStatus(this, 'Asignada')" class="status-btn w-full flex items-center justify-between p-4 rounded-xl border border-slate-100 bg-white hover:bg-slate-50 text-slate-600 transition-all">
                            <span class="font-medium">Asignada</span>
                        </button>
                        <button onclick="setStatus(this, 'Finalizada')" class="status-btn w-full flex items-center justify-between p-4 rounded-xl border border-slate-100 bg-white hover:bg-slate-50 text-slate-600 transition-all">
                            <span class="font-medium">Finalizada</span>
                        </button>
                    </div>
                </div>
                
                <div class="text-center text-xs text-slate-400">
                    Última actualización: Hace un momento
                </div>
            </div>
        </div>
    </section>

     <!-- 4. QUEUE / TURN VIEW -->
    <section id="view-queue" class="view-section hidden-view min-h-screen bg-slate-900 flex flex-col items-center justify-center p-8">
        <div class="w-full max-w-5xl bg-slate-800 rounded-3xl overflow-hidden shadow-2xl border border-slate-700">
            <div class="bg-slate-950 p-6 flex justify-between items-center border-b border-slate-800">
                <h1 class="text-2xl font-light text-white tracking-widest uppercase">Turno Actual</h1>
                <div class="flex items-center gap-2 text-slate-400">
                    <i data-lucide="clock" class="w-5 h-5"></i>
                    <span id="queue-time">12:45 PM</span>
                </div>
            </div>

            <div class="flex flex-col md:flex-row h-96">
                <!-- Left Side: Turn Number -->
                <div class="md:w-2/3 p-12 flex flex-col justify-center border-r border-slate-700 bg-slate-800 relative overflow-hidden">
                    <!-- Abstract background accent -->
                    <div id="queue-accent-bar" class="absolute top-0 left-0 w-2 h-full bg-yellow-500"></div>
                    
                    <p class="text-slate-400 text-2xl font-medium mb-2 uppercase tracking-widest">Turno</p>
                    <h2 class="text-7xl md:text-9xl font-bold text-white mb-6 truncate tracking-tighter display-turn">
                        T-102
                    </h2>
                    <div class="inline-flex items-center gap-4 px-8 py-3 rounded-full self-start bg-slate-700/50 border border-slate-600">
                        <div id="queue-dot" class="w-6 h-6 rounded-full ring-2 ring-offset-2 ring-offset-slate-800 ring-transparent bg-yellow-500"></div>
                        <span class="text-slate-200 uppercase font-bold tracking-wider text-base display-triage-name">Prioridad Urgente</span>
                    </div>
                </div>

                <!-- Right Side: Direction -->
                <div class="md:w-1/3 bg-slate-700 p-10 flex flex-col items-center justify-center text-center">
                    <p class="text-slate-300 text-lg uppercase tracking-widest mb-8">Diríjase a</p>
                    <div class="bg-slate-800 w-40 h-40 rounded-full flex items-center justify-center mb-8 shadow-inner border border-slate-600 text-blue-400">
                        <!-- Dynamic Icon Injected Here -->
                        <div id="direction-icon">
                            <i data-lucide="map-pin" class="w-16 h-16"></i>
                        </div>
                    </div>
                    <h3 class="text-5xl md:text-6xl font-bold text-white leading-tight display-room">
                        Cons. 2
                    </h3>
                </div>
            </div>
        </div>
        
        <div class="mt-12 text-slate-500 font-light tracking-widest text-sm uppercase">
            Hospital General de Especialidades • Favor de mantener la calma y el silencio
        </div>
    </section>

        
</body>
<%- include('partials/footer') %>