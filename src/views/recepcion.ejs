<%- include( 'partials/head', {titulo: 'Recepción - Agregar Consulta'}) %>
<%- include('partials/header' , {user}) %>
<body class="bg-gray-100 min-h-screen">
    <h1 class="text-center">Bienvenido a la página de citas</h1>
    <!-- Agregar boton para poder agregar una nueva cita -->
     <div class="flex justify-center">
        <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" onclick="document.querySelector('dialog').showModal()">
            Agregar Nueva Cita
        </button>
     </div>
     <section>
        <h2>Turnos activos</h2>
     </section>
     <hr class="my-4">
     <section id="areaTurnos" class="mt-8 flex flex-wrap gap-6 justify-center w-11/12">
        <% turnos.forEach(turno => { %>
            <%- include('components/componenteCita',{
                nombre: turno.paciente,
                estado: turno.estatus,
                turno: 'T-' + turno.id,
                triage: {
                    '1': 'Inmediato',
                    '2': 'Muy Urgente',
                    '3': 'Urgente',
                    '4': 'Normal',
                    '5': 'No urgente'
                }[turno.triage],
                color: {
                    '1': 'bg-inmediato',
                    '2': 'bg-muyUrgente',
                    '3': 'bg-urgente',
                    '4': 'bg-normal',
                    '5': 'bg-noUrgente'
                }[turno.triage]
            })  %>
        <%})  %>
    </section>
    <section class="max-w-5xl mx-auto p-4 sm:p-6 lg:p-8">
        <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Médicos en atención: Consultorios</h2>
            <hr class="mt-4 border-t-2 border-gray-100 rounded-full">
        </div>

        <div class="overflow-x-auto shadow-lg sm:rounded-xl border border-gray-200">
            <table class="w-full text-sm text-left text-gray-600">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b-2 border-gray-200">
                    <tr class="bg-blue-950 text-white text-center border-b-2 border-gray-200">
                        <th scope="col" class="px-6 py-4 font-semibold tracking-wider">
                            Consultorio
                        </th>
                        <th scope="col" class="px-6 py-4 font-semibold tracking-wider">
                            Nombre Médico
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <% consultorios.forEach(consultorio => { %>
                        <tr class="bg-white border-b last:border-b-0 hover:bg-blue-50 transition-colors duration-200 ease-in-out group">
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 shadow-sm group-hover:bg-blue-200 transition-colors">
                                    Consultorio <%- consultorio.Consultorio %>
                                </span>
                            </td>
                            <td class="px-6 py-4 font-medium text-gray-800 text-center">
                                <%- consultorio.NombreCompleto %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>

    <dialog class="flex justify-center items-center m-auto p-0 border-0 rounded-lg shadow-lg">
        <section id="view-register" class="bg-slate-50 p-6">
            <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="bg-white border-b border-slate-100 p-1 flex items-center gap-3">
                    <i data-lucide="file-text" class="text-blue-600"></i>
                    <h2 class="text-xl font-semibold text-slate-800">Registro de Paciente & Triage</h2>
                </div>
                
                <div class="p-8 grid grid-cols-1 gap-8">
                    <!-- Datos Personales -->
                     <form id="registrarTurno">
                        <div class="space-y-4">
                             <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 border-b pb-2">Datos Generales</h3>
                             <div>
                                 <label class="block text-sm text-slate-600 mb-1">Nombre</label>
                                 <input id="input-name" name="input-name" type="text" placeholder="Ricardo" required class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                            </div>
                            <section class="grid grid-cols-2">
                                <div>
                                    <label class="block text-sm text-slate-600 mb-1">Apellido Paterno</label>
                                    <input id="input-firstName" type="text" placeholder="Garza" required class="w-11/12 p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                                </div>
                                <div>
                                    <label class="block text-sm text-slate-600 mb-1">Apellido Materno</label>
                                    <input id="input-lastName" type="text" placeholder="Perez" required class="w-11/12 p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                                </div>
                            </section>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm text-slate-600 mb-1">Edad</label>
                                    <input id="input-age" type="number" value="34" class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                                </div>
                                <div>
                                    <label class="block text-sm text-slate-600 mb-1">Sexo</label>
                                    <select id="input-sex" class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                                        <option>Masculino</option>
                                        <option>Femenino</option>
                                        <option>Otro</option>
                                    </select>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm text-slate-600 mb-1">Consulta de seguimiento</label>
                                    <select id="input-seguimiento" class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                                        <option>NINGUNO</option>
                                        <option>CONSULTORIO 1</option>
                                        <option>CONSULTORIO 2</option>
                                        <option>CONSULTORIO 3</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm text-slate-600 mb-1">No. Cuenta</label>
                                    <input id="input-noCuenta" type="number" placeholder="12345" required class="w-full p-2 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-blue-500 outline-none transition-colors">
                                </div>
                            </div>
                        </div>
                        
                        <!-- Manchester Triage Selector -->
                        <div class="md:col-span-2 mt-4">
                            <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-1 border-b pb-0.5">Clasificación Manchester</h3>
                            <div class="grid grid-cols-5 md:grid-cols-5 gap-1 m-2" id="triage-selector">
                                <!-- Red -->
                                <button type="button" onclick="selectTriage('red', 'Inmediato')" class="triage-btn relative p-4 rounded-xl border-2 border-transparent bg-slate-50 hover:bg-slate-100 flex flex-col items-center gap-2 text-center transition-all opacity-70 hover:opacity-100" data-color="red">
                                    <div class="w-6 h-6 rounded-full shadow-sm bg-red-500"></div>
                                    <span class="text-xs font-bold text-slate-700">Inmediato</span>
                                </button>
                                <!-- Orange -->
                                <button type="button"  onclick="selectTriage('orange', 'Muy Urgente')" class="triage-btn relative p-4 rounded-xl border-2 border-transparent bg-slate-50 hover:bg-slate-100 flex flex-col items-center gap-2 text-center transition-all opacity-70 hover:opacity-100" data-color="orange">
                                    <div class="w-6 h-6 rounded-full shadow-sm bg-orange-500"></div>
                                    <span class="text-xs font-bold text-slate-700">Muy Urgente</span>
                                </button>
                                <!-- Yellow (Default Selected in Mock) -->
                                <button type="button"  onclick="selectTriage('yellow', 'Urgente')" class="triage-btn relative p-4 rounded-xl border-2 flex  border-transparent flex-col items-center gap-2 text-center transition-all opacity-70 hover:opacity-100" data-color="yellow">
                                    <div class="w-6 h-6 rounded-full shadow-sm bg-yellow-500"></div>
                                    <span class="text-xs font-bold text-slate-700">Urgente</span>
                                </button>
                                <!-- Green -->
                                <button type="button"  onclick="selectTriage('green', 'Estándar')" class="triage-btn relative p-4 rounded-xl border-2 border-transparent bg-slate-50 hover:bg-slate-100 flex flex-col items-center gap-2 text-center transition-all opacity-70 hover:opacity-100" data-color="green">
                                    <div class="w-6 h-6 rounded-full shadow-sm bg-green-500"></div>
                                    <span class="text-xs font-bold text-slate-700">Estándar</span>
                                </button>
                                <!-- Blue -->
                                <button type="button"  onclick="selectTriage('blue', 'No Urgente')" class="triage-btn active p-4 border-slate-800 bg-white transform scale-105  shadow-md relative rounded-xl border-2 hover:bg-slate-100 flex flex-col items-center gap-2 text-center" data-color="blue">
                                    <div class="w-6 h-6 rounded-full shadow-sm bg-blue-500"></div>
                                    <span class="text-xs font-bold text-slate-700">No Urgente</span>
                                    <div class="absolute top-2 right-2 text-slate-800"><i data-lucide="check-circle" class="w-4 h-4"></i></div>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    
                    <div class="p-6 bg-slate-50 border-t border-slate-100 flex justify-end">
                        <button type="submit" class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition-colors shadow-lg shadow-blue-200">
                            Registrar y generar turno
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </dialog>
    <script src="/js/cita.js"></script>
</body>
<%- include('partials/footer') %>