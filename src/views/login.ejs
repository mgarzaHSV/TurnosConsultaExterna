<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prueba de Turnos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex items-center justify-center min-h-screen bg-[linear-gradient(43deg,rgba(49,95,169,1)_29%,rgba(20,156,91,1)_37%,rgba(249,218,79,1)_100%)]">
    <!-- Login de entrada -->
    <div class="bg-white/30 p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-2xl font-bold mb-6 text-center text-white">Iniciar Sesión</h1>
        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label for="username" class="block text-sm font-medium text-white">Usuario</label>
                <input type="text" autocomplete="username" id="username" name="username" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
                <label for="password" class="block text-sm font-medium text-white">Contraseña</label>
                <input type="password" autocomplete="current-password" id="password" name="password" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
                <button type="submit" class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">Entrar</button>
            </div>
        </form>
        <script>

            const button = document.querySelector('button[type="submit"]');
            button.addEventListener('click', (e) => {
                e.preventDefault(); // Evitar el envío tradicional del formulario
                fetch('/api/v1/login', {
                    method: 'POST',
                    headers: {
                        'X-SRF-TOKEN': getCookie('X-SRF-TOKEN') // Enviar el token en el header
                    },
                    body: new URLSearchParams(new FormData(document.querySelector('form'))) // Enviar los datos del formulario
                }).then(response => {
                    if (response.ok) {
                        window.location.href = '/recepcion'; // Redirigir al dashboard si el login es exitoso
                    } else {
                        alert('Error de autenticación'); // Mostrar un mensaje de error si el login falla
                }}).catch(error => {
                    console.error('Error:', error);
                    alert('Error de red'); // Mostrar un mensaje de error si hay un problema de red
                });

            })
            // Función auxiliar para leer cookies por nombre
            const getCookie = (name) => {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
            };

        </script>
</body>
</html>