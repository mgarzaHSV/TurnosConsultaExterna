<%- include( 'partials/head', {titulo: 'Agregar Consulta'}) %>
    <!-- 4. QUEUE / TURN VIEW (UPDATED TO FULL SCREEN LIST + MODAL) -->
    <section id="view-queue" class="view-section hidden-view min-h-screen bg-slate-900 relative overflow-hidden flex flex-col">
        
        <!-- BOTÓN DE PRUEBA (Solo para demo) -->
        <div class="absolute top-8 right-8 z-40">
            <button onclick="simularNuevoTurno()" class="bg-slate-700/50 hover:bg-slate-600 border border-slate-500 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 backdrop-blur-sm shadow-xl">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
                Simular Siguiente Turno
            </button>
        </div>
        
        <!-- OVERLAY DE ANIMACIÓN: Modal sobre el contenido normal -->
        <div id="queue-modal" class="hidden h-screen absolute inset-0 z-50 flex items-center justify-center p-8 bg-slate-950/80 backdrop-blur-sm transition-all">
            <div id="queue-modal-card" class="bg-slate-900 w-full max-w-5xl rounded-[3rem] shadow-2xl flex flex-col items-center justify-center p-16 border-4 animate-custom-pulse">
                <h1 id="queue-modal-title" class="text-4xl md:text-6xl font-black uppercase tracking-[0.2em] mb-8">
                    Nuevo Turno
                </h1>
                <h2 id="queue-modal-turn" class="text-[10rem] md:text-[14rem] font-black text-white leading-none mb-12 tracking-tighter">
                    T-102
                </h2>
                <div class="flex items-center gap-12 bg-slate-800 px-16 py-8 rounded-full border border-slate-700">
                    <div id="queue-modal-icon"></div>
                    <span id="queue-modal-room" class="text-6xl font-bold text-white">Cons. 2</span>
                </div>
            </div>
        </div>
        
        <!-- VISTA NORMAL: Lista Completa de Turnos -->
        <div class="flex-1 flex flex-col p-8 md:p-12 gap-8 h-screen mx-auto w-full">
            
            <!-- Header -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end border-b border-slate-800 pb-6 gap-4">
                <div>
                    <h1 class="text-4xl font-light text-white tracking-widest uppercase">Últimos Llamados</h1>
                    <p class="text-slate-500 mt-2 tracking-widest uppercase text-sm">Hospital de San Vicente</p>
                </div>
                <div class="flex items-center gap-3 text-slate-400 text-2xl bg-slate-800/50 px-6 py-3 rounded-full border border-slate-700">
                    <i data-lucide="clock" class="w-7 h-7"></i>
                    <span id="queue-time">12:45 PM</span>
                </div>
            </div>
            
            <!-- Lista de Turnos -->
            <div id="queue-list-container" class="flex-1 flex flex-col gap-6 overflow-y-auto pb-8 pr-4">
                <!-- Se inyectan dinámicamente vía JS -->
            </div>
        </div>
    </section>
    <script src="js/turno.js"></script>